public static long stockmax(List<Integer> prices) {
        
    if(prices.size() <= 1){
        return 0;
    }
    int n = prices.size();
    int[] dp = new int[n];
    dp[n-1] = prices.get(n-1);
    
    for(int i=n-2; i>=0; i--){
        dp[i] = Math.max(dp[i+1],prices.get(i));
    }
    
    long profit = 0;
    for(int i=0; i<n; i++){
        profit = profit + (dp[i] - prices.get(i));
    }
    
    return profit;
    
    }
